PORT=5001
HOST=127.0.0.1
NODE_ENV=production
FRONTEND_URL=https://www.i-cape.com
API_PUBLIC_URL=https://api.i-cape.com
DATABASE_URL=postgresql://icape_app:CHANGE_ME@127.0.0.1:5432/icape?schema=public
AUTH_SECRET=CHANGE_ME

# SeaweedFS S3 (localhost only)
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=icape
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Optional
REDIS_URL=
PUBLIC_RATE_LIMIT_MAX=120
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
